+#if (NGX_HAVE_TCP_SAVE_SYN)
+
+#define NGX_TCP_SAVED_SYN_MAX  512
+
+void
+ngx_connection_save_syn(ngx_connection_t *c)
+{
+    u_char     buf[NGX_TCP_SAVED_SYN_MAX], *data;
+    socklen_t  len, capacity;
+
+    if (c->pool == NULL || c->listening == NULL || !c->listening->save_syn) {
+        return;
+    }
+
+    len = NGX_TCP_SAVED_SYN_MAX;
+
+    if (getsockopt(c->fd, IPPROTO_TCP, TCP_SAVED_SYN, buf, &len) == -1) {
+        /* Linux returns the required size without consuming an oversized SYN. */
+        if (ngx_socket_errno != NGX_EINVAL || len <= sizeof(buf)) {
+            return;
+        }
+        capacity = len;
+        data = ngx_pnalloc(c->pool, capacity);
+        if (data == NULL) {
+            return;
+        }
+        if (getsockopt(c->fd, IPPROTO_TCP, TCP_SAVED_SYN, data, &len) == -1
+            || len == 0 || len > capacity)
+        {
+            ngx_pfree(c->pool, data);
+            return;
+        }
+        c->saved_syn.data = data;
+        c->saved_syn.len = len;
+        return;
+    }
+    if (len == 0 || len > sizeof(buf)) {
+        return;
+    }
+
+    c->saved_syn.data = ngx_pnalloc(c->pool, len);
+    if (c->saved_syn.data == NULL) {
+        return;
+    }
+
+    ngx_memcpy(c->saved_syn.data, buf, len);
+    c->saved_syn.len = len;
+
+    ngx_log_debug1(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "saved SYN headers: %uz bytes", c->saved_syn.len);
+}
+
+#endif
+
+
 void
 ngx_free_connection(ngx_connection_t *c)
 {
