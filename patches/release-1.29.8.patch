diff --git a/src/event/ngx_event_openssl.c b/src/event/ngx_event_openssl.c
index 99ec654..3676c5b 100644
--- a/src/event/ngx_event_openssl.c
+++ b/src/event/ngx_event_openssl.c
@@ -2011,6 +2011,53 @@ ngx_ssl_set_client_hello_callback(ngx_ssl_t *ssl, ngx_ssl_client_hello_arg *cb)
 
 #ifdef SSL_CLIENT_HELLO_SUCCESS
 
+size_t ngx_ssl_client_hello_get_ja_data(ngx_ssl_conn_t *ssl, u_char *data,
+    size_t data_size);
+
+
+static void
+ngx_ssl_client_hello_ja_cb(SSL *ssl)
+{
+    ngx_connection_t  *c;
+    ngx_str_t         *ja;
+    size_t             len;
+
+    c = ngx_ssl_get_connection(ssl);
+
+    if (c == NULL || c->ssl == NULL) {
+        return;
+    }
+
+    c->ssl->fp_pool = c->pool;
+
+    ja = &c->ssl->fp_ja_data;
+    if (ja->data != NULL) {
+        return;
+    }
+
+    len = ngx_ssl_client_hello_get_ja_data(ssl, NULL, 0);
+    if (len == 0) {
+        ngx_log_error(NGX_LOG_WARN, c->log, 0,
+                      "ngx_ssl_client_hello_get_ja_data() failed");
+        return;
+    }
+
+    ja->data = ngx_pnalloc(c->pool, len);
+    if (ja->data == NULL) {
+        ja->len = 0;
+        return;
+    }
+
+    ja->len = ngx_ssl_client_hello_get_ja_data(ssl, ja->data, len);
+    if (ja->len != len) {
+        ngx_log_error(NGX_LOG_WARN, c->log, 0,
+                      "ngx_ssl_client_hello_get_ja_data() failed");
+        ja->data = NULL;
+        ja->len = 0;
+    }
+}
+
+
 int
 ngx_ssl_client_hello_callback(ngx_ssl_conn_t *ssl_conn, int *ad, void *arg)
 {
@@ -2025,6 +2072,8 @@ ngx_ssl_client_hello_callback(ngx_ssl_conn_t *ssl_conn, int *ad, void *arg)
     cb = SSL_CTX_get_ex_data(c->ssl->session_ctx,
                              ngx_ssl_client_hello_arg_index);
 
+    ngx_ssl_client_hello_ja_cb(ssl_conn);
+
     if (SSL_client_hello_get0_ext(ssl_conn, TLSEXT_TYPE_server_name,
                                   (const unsigned char **) &p, &len)
         == 0)
